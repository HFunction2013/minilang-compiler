// main.mil - Unified minilang toolchain entry point, fully self-hosted
// Replaces main.c. Requires compiler.mil, vm.mil, milc_io.mil.
// Usage: ./minilang run main.mil <command> [args...]
//   run <file>           Compile .mil and run, or run precompiled .milc/text bytecode
//   dump-text <file>     Compile and dump text bytecode (or read a .milc file)
//   c <file>             Compile to C source
//   build [opts] <file>  Compile to native executable or bytecode file
//     -b, --bytecode     write binary bytecode file (.milc, magic "!milc")
//     -e, --executable   write native executable (C source + system cc -O2, default)
require compiler;
require vm;
require milc_io;
require getenv from builtin;

// Host VM bridge used by `run -e prog.mil prebuilt-lib ...`: ext_build_load
// dlopens the prebuilt user extension library into the host registry. The
// toolchain never compiles extension C on the fly; pass a precompiled object,
// archive or shared library.
native func ext_build_load(ext_paths, names, params);

// Detect Windows: OS env var is "Windows_NT" on Windows, unset on Unix.
var g_is_windows = 0;
func detect_windows() {
    var os = getenv("OS");
    if (len(os) >= 7 && strcmp(substr(os, 0, 7), "Windows") == 0) {
        g_is_windows = 1;
    }
}
func print_usage() {
    println "Usage: main <command> [args...]";
    println "Commands:";
    println "  run <file>           Compile and run .mil (or run text bytecode)";
    println "  bytecode <file>      Disassemble .mil, or read a .milc bytecode file";
    println "  dump-text <file>     Text bytecode for .mil, or read a .milc bytecode file";
    println "  c <file>            Compile to C source";
    println "  repl                 Start interactive REPL";
    println "  self-test [file]   Run self-hosting verification (compiler.mil, default cwd)";
    println "  build [opts] <file>  Build native executable or bytecode";
    println "    -b, --bytecode     write binary .milc (magic \"!milc\")";
    println "    -e, --executable   write native executable (default)";
}
func is_bytecode_text(src) {
    if (len(src) < 10) { return 0; }
    return strcmp(substr(src, 0, 10), "MINILANGBC") == 0;
}
// syslib ships next to main.mil. Work out where that is from our own path, so
// that `main.mil run sub/x.mil` finds it from any working directory. Falls back
// to cwd-relative and parent-relative "syslib" when it cannot be determined,
// and always verifies the candidate actually contains a known syslib file so
// we never silently point at an empty directory (e.g. an uninitialized
// submodule). The first match wins.
var g_syslib_dir = "syslib";
func find_syslib_dir() {
    var cands = array(8, "");
    var ccount = 0;
    // 1. Directory of the running binary/script + "/syslib". For a native
    //    executable invoked as "./main" this is "." (skipped); for an absolute
    //    path or a script in another directory it gives an absolute syslib.
    if (argc() > 0) {
        var d = compiler.dirname(argv(0));
        if (d != ".") {
            cands[ccount] = d + "/syslib";
            ccount = ccount + 1;
        }
    }
    // 2. cwd-relative (the common case: running from the repo root).
    cands[ccount] = "syslib";
    ccount = ccount + 1;
    // 3. Parent and grandparent (running from tests/ or a subdirectory).
    cands[ccount] = "../syslib";
    ccount = ccount + 1;
    cands[ccount] = "../../syslib";
    ccount = ccount + 1;
    // Return the first candidate that actually holds a known syslib module.
    var i = 0;
    while (i < ccount) {
        if (fileExists(cands[i] + "/math.mil") == 1) {
            return cands[i];
        }
        i = i + 1;
    }
    // Nothing found: keep "syslib" so the compiler reports a clear
    // "cannot find module" error rather than silently using a wrong path.
    return "syslib";
}
func parse_source(file, src) {
    var state = compiler.make_state(src);
    state[28] = compiler.dirname(file);
    state[29] = g_syslib_dir;
    compiler.lex_source(state);
    compiler.parse_program(state);
    if (state[30] == 1) {
        println "Parse failed — aborting (fix the errors above and retry).";
    }
    return state;
}
func compile_to_bytecode(file, src) {
    var state = parse_source(file, src);
    if (state[30] == 1) { return ""; }
    compiler.compile_program(state);
    return compiler.output_bytecode(state);
}
// Replace file extension with new_ext (e.g., "foo.mil" -> "foo.milc")
func replace_ext(file, new_ext) {
    var dot = -1;
    var i = len(file) - 1;
    while (i >= 0) {
        if (charAt(file, i) == 46) { dot = i; i = -1; }
        else { i = i - 1; }
    }
    var base = "";
    if (dot >= 0) {
        base = substr(file, 0, dot);
    } else {
        base = file;
    }
    return base + new_ext;
}
// Get the directory holding this entry file (used to locate the sibling boot repo).
func get_toolchain_dir() {
    // Try dirname of argv(0) if it has a path separator (slash or backslash)
    var a0 = argv(0);
    var i = len(a0) - 1;
    while (i >= 0) {
        var c = charAt(a0, i);
        if (c == 47 || c == 92) {
            return substr(a0, 0, i + 1);
        }
        i = i - 1;
    }
    return "./";
}
// Locate the host bootstrap toolchain binary so native builds can delegate to
// the boot C backend. Prefer MINILANG_BOOT (set by the host executable), then
// the sibling minilang-boot repo next to this entry file, then a bare name on
// PATH.
func host_binary() {
    var b = getenv("MINILANG_BOOT");
    if (len(b) > 0) { return b; }
    var d = get_toolchain_dir();
    var name = "minilang";
    if (g_is_windows == 1) { name = "minilang.exe"; }
    var cand = d + "../minilang-boot/" + name;
    if (fileExists(cand) == 1) { return cand; }
    cand = d + name;
    if (fileExists(cand) == 1) { return cand; }
    return name;
}
// Detect binary .milc magic "!milc" (readFile truncates at \0, but first 5 bytes are safe)
func is_milc_binary(src) {
    if (len(src) < 5) { return 0; }
    if (charAt(src, 0) != 33) { return 0; }
    if (charAt(src, 1) != 109) { return 0; }
    if (charAt(src, 2) != 105) { return 0; }
    if (charAt(src, 3) != 108) { return 0; }
    if (charAt(src, 4) != 99) { return 0; }
    return 1;
}
// Scan source text for `native func name(p1, p2);` declarations and return
// [names_array, params_array, count]. Used to drive the C extension loader
// (run -e) without depending on compiler-internal state.
func scan_native_decls(src) {
    var names = array(64, "");
    var params = array(64, 0);
    var nd = 0;
    var L = len(src);
    var i = 0;
    while (i + 12 <= L && nd < 64) {
        if (strcmp(substr(src, i, 12), "native func ") == 0) {
            var j = i + 12;
            var nm = "";
            var done = 0;
            while (j < L && done == 0) {
                var c = charAt(src, j);
                if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||
                    (c >= 48 && c <= 57) || c == 95) {
                    nm = nm + chr(c);
                    j = j + 1;
                } else { done = 1; }
            }
            if (len(nm) > 0) {
                while (j < L && (charAt(src, j) == 32 || charAt(src, j) == 9)) { j = j + 1; }
                var pc = 0;
                var seen = 0;
                if (j < L && charAt(src, j) == 40) {
                    j = j + 1;
                    while (j < L && charAt(src, j) != 41) {
                        var c2 = charAt(src, j);
                        if (c2 == 44) { pc = pc + 1; }
                        else if (c2 != 32 && c2 != 9) { seen = 1; }
                        j = j + 1;
                    }
                    if (seen == 1) { pc = pc + 1; }
                }
                names[nd] = nm;
                params[nd] = pc;
                nd = nd + 1;
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    return [names, params, nd];
}

func cmd_run(n) {
    if (n < 3) {
        println "Error: run requires a filename";
        return 1;
    }
    if (strcmp(argv(2), "-e") == 0 || strcmp(argv(2), "--executable") == 0) {
        // run -e prog.mil ext.c ... [-- progargs...]
        // Compile prog.mil to bytecode, then ask the host VM to compile and
        // dlopen every user C extension (registering its natives), and run
        // the program inside this self-hosted VM.
        var file = argv(3);
        var src = readFile(file);
        var bc_text = compile_to_bytecode(file, src);
        if (len(bc_text) == 0) { return 1; }
        // Collect extension sources up to "--". Build an exact-sized array
        // (the C loader trusts the array length, so padding would be read as
        // extra extensions / declarations).
        var k = 4;
        while (k < n && strcmp(argv(k), "--") != 0) {
            k = k + 1;
        }
        var ec = k - 4;
        var exts = array(ec, "");
        var ei = 0;
        while (ei < ec) {
            exts[ei] = argv(4 + ei);
            ei = ei + 1;
        }
        if (ec > 0) {
            var decls = scan_native_decls(src);
            var nd = decls[2];
            var dnames = array(nd, "");
            var dparams = array(nd, 0);
            var di = 0;
            while (di < nd) {
                dnames[di] = decls[0][di];
                dparams[di] = decls[1][di];
                di = di + 1;
            }
            ext_build_load(exts, dnames, dparams);
        }
        // Remap program argv: argv(0)=prog file, then everything after "--".
        var pac = 1;
        if (k < n) { pac = pac + (n - k - 1); }
        var pargs = array(pac, "");
        pargs[0] = file;
        if (k < n) {
            var j = 1;
            k = k + 1;
            while (k < n) {
                pargs[j] = argv(k);
                j = j + 1;
                k = k + 1;
            }
        }
        vm.set_prog_args(pargs);
        vm.run_bytecode(bc_text);
        return 0;
    }
    var file = argv(2);
    var src = readFile(file);
    g_prog_argc = n - 2;
    g_prog_argv_offset = 2;
    if (is_milc_binary(src)) {
        // Binary .milc (magic "!milc"): parse it directly, no external tools
        var bytes = readFileBytes(file);
        var prog = milc_io.decode_bytes(bytes);
        vm.run_milc(prog);
        return 0;
    }
    var bc_text = "";
    if (is_bytecode_text(src)) {
        bc_text = src;
    } else {
        bc_text = compile_to_bytecode(file, src);
    }
    if (len(bc_text) == 0) { return 1; }
    vm.run_bytecode(bc_text);
    return 0;
}
// Convert a decoded .milc program (9-slot layout) into the compiler-state
// layout that compiler.output_bytecode and the disassembly printer consume.
// Constants are re-tagged: [1,v] -> [0,v,""] (int), [2,s] -> [1,0,s] (string),
// and nil constants become [0,0,""] to match how nil is emitted as "0 0".
func state_from_prog(prog) {
    var const_count = prog[0];
    var raw = prog[1];
    var consts = array(const_count + 1, 0);
    var i = 0;
    while (i < const_count) {
        var c = raw[i];
        if (c[0] == 1) {
            consts[i] = [0, c[1], ""];
        } else if (c[0] == 2) {
            consts[i] = [1, 0, c[1]];
        } else {
            consts[i] = [0, 0, ""];
        }
        i = i + 1;
    }
    var st = array(17, 0);
    st[6] = consts;
    st[7] = const_count;
    st[8] = [prog[3], prog[4], prog[5], prog[6], prog[2]];
    st[10] = prog[8];
    st[11] = prog[7] * 3;
    return st;
}
// Load a .milc file into a compiler-state-like structure, or compile a .mil source
func load_or_parse(file, src) {
    if (is_milc_binary(src)) {
        return state_from_prog(milc_io.decode_bytes(readFileBytes(file)));
    }
    var st = parse_source(file, src);
    compiler.compile_program(st);
    return st;
}

func cmd_dump_text(n) {
    if (n < 3) {
        println "Error: dump-text requires a filename";
        return 1;
    }
    var file = argv(2);
    var src = readFile(file);
    if (is_bytecode_text(src)) {
        print src;
        return 0;
    }
    if (is_milc_binary(src)) {
        print compiler.output_bytecode(state_from_prog(milc_io.decode_bytes(readFileBytes(file))));
        return 0;
    }
    var bc = compile_to_bytecode(file, src);
    print bc;
    return 0;
}
func cmd_c(n) {
    if (n < 3) {
        println "Error: c requires a filename";
        return 1;
    }
    var file = argv(2);
    // Native C emission lives in the boot C backend; delegate so the self-hosted
    // compiler and the bootstrap toolchain always emit the same C source.
    var cmd = host_binary() + " c " + file;
    var rc = system(cmd);
    if (rc != 0) {
        println "C source generation failed";
        return 1;
    }
    return 0;
}
// build -b: compile to binary .milc file (magic "!milc", matches boot exactly)
func cmd_build_bytecode(file) {
    var src = readFile(file);
    var state = parse_source(file, src);
    compiler.compile_program(state);
    var outpath = replace_ext(file, ".milc");
    // Encode and write the real binary format directly
    var ok = milc_io.write_milc(outpath, state);
    if (ok != 1) {
        println "Error: cannot write " + outpath;
        return 1;
    }
    println "Bytecode written: " + outpath + " (magic \"!milc\")";
    return 0;
}
// build -e: compile to a native executable.
// ext_files: optional PRECOMPILED extension artefacts (object / archive /
// shared library) linked into the executable. Raw .c sources are rejected by
// the boot backend; precompile them yourself first. Native functions declared
// in prog.mil resolve to ml_native_<base> symbols defined in those artefacts.
//
// Native C emission and the system cc -O2 link live in the boot C backend; the
// self-hosted compiler delegates to the host binary so both toolchains build
// identically.
func cmd_build_executable(file, ext_files) {
    var cmd = host_binary() + " build -e " + file;
    var ei = 0;
    while (ei < len(ext_files)) {
        if (len(ext_files[ei]) > 0) {
            cmd = cmd + " " + ext_files[ei];
        }
        ei = ei + 1;
    }
    var rc = system(cmd);
    if (rc != 0) {
        println "C compilation failed";
        return 1;
    }
    println "Executable built: " + file;
    return 0;
}
func cmd_build(n) {
    if (n < 3) {
        println "Error: build requires a filename";
        return 1;
    }
    var argi = 2;
    var mode = 0; // 0=executable(default), 1=bytecode
    var file = "";
    var ext_files = array(8, "");
    var ext_count = 0;
    while (argi < n) {
        var a = argv(argi);
        if (strcmp(a, "-b") == 0 || strcmp(a, "--bytecode") == 0) {
            mode = 1;
            argi = argi + 1;
        } else if (strcmp(a, "-e") == 0 || strcmp(a, "--executable") == 0) {
            mode = 0;
            argi = argi + 1;
        } else if (strcmp(a, "--dynamic") == 0) {
            // Accepted for backwards compatibility: prebuilt shared libraries
            // are already dynamic; the flag no longer changes the link mode.
            argi = argi + 1;
        } else if (len(file) == 0) {
            // First non-option argument is the source file.
            file = a;
            argi = argi + 1;
        } else {
            // Remaining non-option arguments are user C extension sources.
            if (ext_count >= len(ext_files)) {
                var bigger = array(len(ext_files) * 2, "");
                var ci = 0;
                while (ci < ext_count) {
                    bigger[ci] = ext_files[ci];
                    ci = ci + 1;
                }
                ext_files = bigger;
            }
            ext_files[ext_count] = a;
            ext_count = ext_count + 1;
            argi = argi + 1;
        }
    }
    if (len(file) == 0) {
        println "Error: build requires a filename";
        return 1;
    }
    if (mode == 1) {
        if (ext_count > 0) {
            println "Warning: C extensions are ignored for bytecode output";
        }
        return cmd_build_bytecode(file);
    }
    return cmd_build_executable(file, ext_files);
}
// Map opcode number to mnemonic (matches boot dump_bytecode)
func opcode_name(op) {
    var names = array(64, "???");
    names[0] = "CONST";
    names[1] = "NIL";
    names[2] = "ADD";
    names[3] = "SUB";
    names[4] = "MUL";
    names[5] = "DIV";
    names[6] = "MOD";
    names[7] = "NEG";
    names[8] = "EQ";
    names[9] = "NEQ";
    names[10] = "LT";
    names[11] = "GT";
    names[12] = "LTE";
    names[13] = "GTE";
    names[14] = "AND";
    names[15] = "OR";
    names[16] = "NOT";
    names[17] = "LOAD";
    names[18] = "STORE";
    names[19] = "PRINT";
    names[20] = "PRINTLN";
    names[21] = "JMP";
    names[22] = "JMPF";
    names[23] = "CALL";
    names[24] = "RET";
    names[25] = "ARRAY";
    names[26] = "INDEX";
    names[27] = "INDEX_SET";
    names[28] = "POP";
    names[29] = "HALT";
    names[30] = "CONCAT";
    names[31] = "LEN";
    names[32] = "CHARAT";
    names[33] = "SUBSTR";
    names[34] = "TOSTRING";
    names[35] = "TOINT";
    names[36] = "STRCMP";
    names[37] = "LOAD_GLOBAL";
    names[38] = "STORE_GLOBAL";
    names[39] = "READALL";
    names[40] = "MAKE_ARRAY";
    names[41] = "ARGC";
    names[42] = "ARGV";
    names[43] = "READFILE";
    names[44] = "FILEEXISTS";
    names[45] = "WRITEFILE";
    names[46] = "SYSTEM";
    names[47] = "READLINE";
    names[48] = "READFILEBYTES";
    names[49] = "WRITEFILEBYTES";
    names[50] = "CHR";
    return names[op];
}
// Right-align a number in a field of width w (matches boot %6d)
func pad_right(s, w) {
    var r = s;
    while (len(r) < w) {
        r = " " + r;
    }
    return r;
}
// Left-align a name in a field of width w (matches boot %-12s)
func pad_left(s, w) {
    var r = s;
    while (len(r) < w) {
        r = r + " ";
    }
    return r;
}
// cmd bytecode: human-readable disassembly (matches boot dump_bytecode)
func cmd_bytecode(n) {
    if (n < 3) {
        println "Error: bytecode requires a filename";
        return 1;
    }
    var file = argv(2);
    var src = readFile(file);
    var state = load_or_parse(file, src);
    // Constants
    println "=== Constants (" + toString(state[7]) + ") ===";
    var i = 0;
    while (i < state[7]) {
        var c = state[6][i];
        var out = "  [" + toString(i) + "] ";
        if (c[0] == 0) {
            out = out + toString(c[1]);
        } else if (c[0] == 1) {
            out = out + toString(c[2]);
        } else {
            out = out + "nil";
        }
        println out;
        i = i + 1;
    }
    // Functions
    var fcount = state[8][4];
    println "=== Functions (" + toString(fcount) + ") ===";
    i = 0;
    while (i < fcount) {
        println "  [" + toString(i) + "] " + state[8][0][i] + " addr=" + toString(state[8][1][i]) + " params=" + toString(state[8][2][i]) + " locals=" + toString(state[8][3][i]);
        i = i + 1;
    }
    // Instructions
    var num_instr = state[11] / 3;
    println "=== Bytecode (" + toString(num_instr) + " instructions) ===";
    i = 0;
    while (i < num_instr) {
        var op = state[10][i * 3];
        var op1 = state[10][i * 3 + 1];
        var op2 = state[10][i * 3 + 2];
        var idx_s = pad_right(toString(i), 4);
        var name_s = pad_left(opcode_name(op), 12);
        var op1_s = pad_right(toString(op1), 6);
        var op2_s = pad_right(toString(op2), 6);
        println "  " + idx_s + ": " + name_s + " " + op1_s + " " + op2_s;
        i = i + 1;
    }
    return 0;
}
// cmd self-test: compile compiler.mil with the mil compiler and dump its bytecode
func cmd_self_test(n) {
    var file = "compiler.mil";
    if (n > 2) { file = argv(2); }
    println "=== Self-hosting test ===";
    var src = readFile(file);
    var state = parse_source(file, src);
    compiler.compile_program(state);
    var bc = compiler.output_bytecode(state);
    print bc;
    println "(mil self-test: " + file + " bytecode dumped above)";
    return 0;
}
// cmd repl: interactive REPL (matches boot repl)
func cmd_repl() {
    println "minilang REPL (type 'quit' to exit)";
    var env = "";
    while (1) {
        print "mil> ";
        var line = readLine();
        if (len(line) == 0) { println ""; break; }
        if (strcmp(line, "quit") == 0 || strcmp(line, "exit") == 0) { break; }
        // Multi-line block support: if braces unbalanced, keep reading
        var open_b = 0;
        var close_b = 0;
        var ci = 0;
        while (ci < len(line)) {
            var ch = charAt(line, ci);
            if (ch == 123) { open_b = open_b + 1; }
            if (ch == 125) { close_b = close_b + 1; }
            ci = ci + 1;
        }
        while (open_b > close_b) {
            print "...> ";
            var more = readLine();
            if (len(more) == 0) { break; }
            line = line + more;
            var mi = 0;
            while (mi < len(more)) {
                var ch = charAt(more, mi);
                if (ch == 123) { open_b = open_b + 1; }
                if (ch == 125) { close_b = close_b + 1; }
                mi = mi + 1;
            }
        }
        // Classify: leading keyword => declaration
        var ti = 0;
        while (ti < len(line) && (charAt(line, ti) == 32 || charAt(line, ti) == 9)) { ti = ti + 1; }
        var trimmed = substr(line, ti, len(line) - ti);
        var is_decl = 0;
        if (len(trimmed) >= 5 && strcmp(substr(trimmed, 0, 5), "func ") == 0) { is_decl = 1; }
        else if (len(trimmed) >= 4 && strcmp(substr(trimmed, 0, 4), "var ") == 0) { is_decl = 1; }
        else if (len(trimmed) >= 8 && strcmp(substr(trimmed, 0, 8), "require ") == 0) { is_decl = 1; }
        if (is_decl) {
            env = env + line + "\n";
            println "(defined)";
        } else {
            var ends_semi = 0;
            var ends_brace = 0;
            if (len(line) > 0 && charAt(line, len(line) - 1) == 59) { ends_semi = 1; }
            if (len(line) > 0 && charAt(line, len(line) - 1) == 125) { ends_brace = 1; }
            var src = env + "func main() {";
            if (ends_semi == 0 && ends_brace == 0) {
                src = src + " println (" + line + ");";
            } else {
                src = src + line;
            }
            src = src + " return 0; }";
            var state = compiler.make_state(src);
            state[28] = ".";
            compiler.lex_source(state);
            compiler.parse_program(state);
            compiler.compile_program(state);
            var bc = compiler.output_bytecode(state);
            g_prog_argc = 0;
            g_prog_argv_offset = 0;
            vm.run_bytecode(bc);
        }
    }
    return 0;
}
func main() {
    detect_windows();
    var n = argc();
    g_syslib_dir = find_syslib_dir();
    if (n < 2) {
        print_usage();
        return 1;
    }
    var cmd = argv(1);
    if (strcmp(cmd, "run") == 0) {
        return cmd_run(n);
    } else if (strcmp(cmd, "bytecode") == 0) {
        return cmd_bytecode(n);
    } else if (strcmp(cmd, "self-test") == 0) {
        return cmd_self_test(n);
    } else if (strcmp(cmd, "repl") == 0) {
        return cmd_repl();
    } else if (strcmp(cmd, "dump-text") == 0) {
        return cmd_dump_text(n);
    } else if (strcmp(cmd, "c") == 0) {
        return cmd_c(n);
    } else if (strcmp(cmd, "build") == 0) {
        return cmd_build(n);
    } else if (strcmp(cmd, "--help") == 0 || strcmp(cmd, "-h") == 0) {
        print_usage();
        return 0;
    } else {
        println "Unknown command: " + cmd;
        print_usage();
        return 1;
    }
}
